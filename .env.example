# CivicLens Environment Configuration
# Copy to .env.local and configure

# AI Vision API (optional — mock classifier used when not set)
VISION_API_KEY=
VISION_API_URL=

# Database (SQLite path, defaults to ./civiclens.db)
DATABASE_URL=./civiclens.db

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
